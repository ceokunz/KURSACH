<Window x:Class="progahell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:progahell"
        mc:Ignorable="d"
        Title="ProgaHELL"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize">
    
    <Grid>
        <Grid x:Name="StartOverlay" Visibility="Visible" Panel.ZIndex="100" >
            <Image x:Name="StartBackground"
           Source="Elements/Background_start.png"
           Stretch="UniformToFill"/>
            <Image x:Name="TitleImage"
           Source="Elements/Logo.png"
           Width="1000"
           VerticalAlignment="Top"
           Margin="0,190,0,0"
           RenderTransformOrigin="0.5,0.5">
                <Image.RenderTransform>
                    <TranslateTransform x:Name="TitleTransform" Y="0"/>
                </Image.RenderTransform>
            </Image>
            <Button x:Name="StartGameButton"
            Content="НАЧАТЬ ИГРУ"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Height="80"
            FontSize="20"
            Style="{StaticResource NextButtonStyle}"
            Click="StartGameButton_Click" Margin="5,5,5,50"/>
        </Grid>
        
        <Grid x:Name="EndingOverlay" Visibility="Collapsed" Panel.ZIndex="100">
            <Image x:Name="EndingBackground" Stretch="UniformToFill" Source="Elements/Background_Credits.png"/>
            <Button x:Name="BackToMenuButton" Content="В МЕНЮ" 
            Style="{StaticResource NextButtonStyle}"
            Height="80"
            HorizontalAlignment="Center" VerticalAlignment="Bottom" 
            Margin="0,0,0,50" Padding="20,10" FontSize="20"
            Click="BackToMenuButton_Click" Visibility="Collapsed"/>
        </Grid>

        <DockPanel Height="100" VerticalAlignment="Top" Panel.ZIndex="200">
            <Button Content="×"
            DockPanel.Dock="Right"
            Width="50"
            Height="50"
            HorizontalAlignment="Right"
            Click="CloseGameButton_Click"
            Style="{StaticResource CloseButtonStyle}"/>
        </DockPanel>

        <Grid x:Name="MainGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="0.7*"/>
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,-200">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Image Grid.Column="0" x:Name="LeftPos"></Image>
                <Image Grid.Column="1" x:Name="CenterPos"></Image>
                <Image Grid.Column="2" x:Name="RightPos"></Image>
            </Grid>

            <Grid x:Name="Choices" Margin="0,0,0,-400" Panel.ZIndex="3">
                <ItemsControl x:Name="ChoicesPanel" Visibility="Collapsed" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource ChoiceButtonStyle}" Content="{Binding Text}" Height="90"
                            Tag="{Binding}" Click="ChoiceButton_Click" Padding="10,5"
                        MinWidth="100"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>

            <Grid x:Name="Choices_Back" Margin="0,0,0,-800" Panel.ZIndex="2" Visibility="Hidden">
                <Image Source="Res/choices_back.png" Stretch="Fill"></Image>
            </Grid>

            <Grid Grid.Row="1" Panel.ZIndex="1">
                <Border Style="{StaticResource DialogueWindowBorderStyle}">
                    <Grid>
                        <Grid Margin="40">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="0.8*"/>
                                <RowDefinition Height="1*"/>
                                <RowDefinition Height="1*"/>
                                <RowDefinition Height="Auto"/>
                                <!--<RowDefinition Height="1*"/>-->
                            </Grid.RowDefinitions>
                            
                            <TextBlock x:Name="SpeakerNameBlock"
                           Text="{Binding SpeakerName}"
                           FontSize="50"
                           FontFamily="Cascadia Code SemiBold"
                           Foreground="White"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Bottom"
                           Margin="0,0,0,10"/>
    
                           <TextBlock x:Name="DialogueTextBlock"
                           Text="{Binding CurrentDialogueText}"
                           Opacity="0"
                           Grid.Row="1"
                           FontSize="40"
                           FontFamily="Cascadia Code SemiBold"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top"
                           Margin="50,30,0,0"/>

                            <Grid Grid.Row="2" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                <Button x:Name="NextButton" Width="200" Height="90"
                            Content="ДАЛЕЕ"
                            Click="Next_Click"
                            Visibility="Visible"
                            Style="{StaticResource NextButtonStyle}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"/>
                            </Grid>

                            <!--<TextBlock FontSize="50" Background="Aqua" Text="{Binding ScoreCalculator.TotalScore, RelativeSource={RelativeSource AncestorType=Window}}"></TextBlock>-->

                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
    
</Window>
