<Window x:Class="progahell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:progahell"
        mc:Ignorable="d"
        Title="ProgaHELL" Height="900" Width="1600">
    
    <Grid>
        <Grid x:Name="MainGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="0.7*"/>
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,-200">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Image Grid.Column="0" x:Name="LeftPos"></Image>
                <Image Grid.Column="1" x:Name="CenterPos"></Image>
                <Image Grid.Column="2" x:Name="RightPos"></Image>
            </Grid>

            <Grid x:Name="Choices" Margin="0,0,0,-400" Panel.ZIndex="3">
                <ItemsControl x:Name="ChoicesPanel" Visibility="Collapsed" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource ChoiceButtonStyle}" Content="{Binding Text}" Height="90"
                            Tag="{Binding}" Click="ChoiceButton_Click" Padding="10,5"
                        MinWidth="100"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>

            <Grid x:Name="Choices_Back" Margin="0,0,0,-800" Panel.ZIndex="2" Visibility="Hidden">
                <Image Source="Res/choices_back.png" Stretch="Fill"></Image>
            </Grid>

            <Grid Grid.Row="1" Panel.ZIndex="1">
                <Border Style="{StaticResource DialogueWindowBorderStyle}">
                    <Grid>
                        <Grid Margin="40">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="0.8*"/>
                                <RowDefinition Height="1*"/>
                                <RowDefinition Height="1*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <TextBlock x:Name="SpeakerNameBlock"
                           Text=""
                           FontSize="50"
                           FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Bottom"
                           Margin="0,0,0,10"/>
    
                            <TextBlock x:Name="DialogueTextBlock"
                           Grid.Row="1"
                           FontSize="40"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top"
                           Margin="0,30,0,0"/>

                            <Grid Grid.Row="2" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                <Button x:Name="NextButton" Width="200" Height="90"
                            Content="NEXT"
                            Click="Next_Click"
                            Visibility="Visible"
                            Style="{StaticResource NextButtonStyle}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"/>
                            </Grid>

                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
    
</Window>
